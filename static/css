/* ==================== CSS VARIABLES ==================== */
:root {
    --gold: #C9A84C;
    --gold-light: #E8C97A;
    --dark: #0D0D0D;
    --dark-2: #141414;
    --dark-3: #1E1E1E;
    --dark-4: #2A2A2A;
    --cream: #F5F0E8;
    --cream-2: #EDE8DC;
    --white: #FFFFFF;
    --text-muted: #888888;
    --text-light: #BBBBBB;
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'DM Sans', sans-serif;
    --nav-h: 80px;
    --radius: 16px;
    --shadow: 0 20px 60px rgba(0,0,0,0.15);
    --shadow-hover: 0 30px 80px rgba(0,0,0,0.25);
    --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* ==================== RESET ==================== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
    font-family: var(--font-body);
    background: var(--cream);
    color: var(--dark);
    line-height: 1.6;
    overflow-x: hidden;
}

img { max-width: 100%; display: block; }
a { text-decoration: none; color: inherit; }
ul { list-style: none; }

/* ==================== NAVBAR ==================== */
.navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--nav-h);
    z-index: 1000;
    transition: var(--transition);
    padding: 0 2rem;
}

.navbar.scrolled {
    background: rgba(13,13,13,0.97);
    backdrop-filter: blur(20px);
    box-shadow: 0 2px 40px rgba(0,0,0,0.3);
}

.nav-container {
    max-width: 1400px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--white);
}

.logo-icon {
    color: var(--gold);
    font-size: 1.4rem;
    animation: spin 8s linear infinite;
}

@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.logo-text {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.02em;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.nav-link {
    color: rgba(255,255,255,0.85);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: var(--transition);
    text-transform: uppercase;
}

.nav-link:hover, .nav-link.active { color: var(--gold); }

.nav-cta {
    background: var(--gold);
    color: var(--dark) !important;
    padding: 0.6rem 1.4rem !important;
    border-radius: 50px !important;
    font-weight: 600 !important;
}

.nav-cta:hover { background: var(--gold-light); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(201,168,76,0.4); }

.nav-dropdown { position: relative; }

.dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: var(--dark-2);
    border: 1px solid rgba(201,168,76,0.2);
    border-radius: 12px;
    padding: 0.75rem;
    min-width: 200px;
    opacity: 0;
    pointer-events: none;
    transition: var(--transition);
    box-shadow: var(--shadow);
}

.nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
}

.dropdown-menu a {
    display: block;
    color: var(--white);
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: var(--transition);
}

.dropdown-menu a:hover { background: rgba(201,168,76,0.15); color: var(--gold); }

.nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
}

.nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: var(--transition);
}

/* ==================== HERO CAROUSEL ==================== */
.hero {
    height: 100vh;
    min-height: 700px;
    position: relative;
    overflow: hidden;
}

.carousel { width: 100%; height: 100%; }

.carousel-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
}

.carousel-slide.active { opacity: 1; z-index: 1; }

.slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.1) 100%);
}

.slide-content {
    position: absolute;
    left: 8%;
    bottom: 15%;
    z-index: 2;
    color: var(--white);
    max-width: 600px;
}

.slide-tag {
    display: inline-block;
    background: var(--gold);
    color: var(--dark);
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
}

.slide-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1;
    margin-bottom: 0.75rem;
    text-shadow: 0 4px 30px rgba(0,0,0,0.5);
}

.slide-sub {
    font-size: 1.2rem;
    opacity: 0.9;
    margin-bottom: 2rem;
    font-style: italic;
}

.btn-hero {
    display: inline-block;
    background: var(--gold);
    color: var(--dark);
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.05em;
    transition: var(--transition);
    box-shadow: 0 8px 30px rgba(201,168,76,0.4);
}

.btn-hero:hover { background: var(--gold-light); transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(201,168,76,0.5); }

.carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.3);
    color: var(--white);
    width: 54px; height: 54px;
    border-radius: 50%;
    font-size: 1.3rem;
    cursor: pointer;
    transition: var(--transition);
}

.carousel-btn:hover { background: var(--gold); border-color: var(--gold); color: var(--dark); }
.prev { left: 2rem; }
.next { right: 2rem; }

.carousel-dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 10;
}

.dot {
    width: 8px; height: 8px;
    background: rgba(255,255,255,0.4);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: var(--transition);
    padding: 0;
}

.dot.active { background: var(--gold); width: 28px; border-radius: 4px; }

/* ==================== SEARCH ==================== */
.search-section {
    background: var(--dark);
    padding: 2rem;
    position: relative;
    z-index: 5;
}

.search-box {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 0;
    background: var(--dark-3);
    border: 1px solid rgba(201,168,76,0.2);
    border-radius: 16px;
    overflow: hidden;
}

.search-field {
    padding: 1.2rem 1.5rem;
    border-right: 1px solid rgba(201,168,76,0.1);
}

.search-field label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 0.3rem;
}

.search-field input,
.search-field select {
    background: none;
    border: none;
    color: var(--white);
    font-family: var(--font-body);
    font-size: 0.95rem;
    width: 100%;
    outline: none;
}

.search-field select option { background: var(--dark-3); }

.search-btn {
    background: var(--gold);
    color: var(--dark);
    border: none;
    padding: 0 2.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.05em;
    transition: var(--transition);
}

.search-btn:hover { background: var(--gold-light); }

/* ==================== STATS ==================== */
.stats-section {
    background: var(--dark);
    padding: 3rem 2rem;
    border-top: 1px solid rgba(201,168,76,0.1);
}

.stats-grid {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
}

.stat-item { color: var(--white); }

.stat-num {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    color: var(--gold);
}

.stat-suffix { font-family: var(--font-display); font-size: 2rem; color: var(--gold); }
.stat-item p { color: var(--text-light); font-size: 0.9rem; margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.1em; }

/* ==================== SECTION HEADERS ==================== */
.section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
}

.section-tag {
    display: inline-block;
    background: rgba(201,168,76,0.15);
    color: var(--gold);
    border: 1px solid rgba(201,168,76,0.3);
    padding: 0.3rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
}

.section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--dark);
    margin-bottom: 1rem;
}

.section-title em { font-style: italic; color: var(--gold); }

.section-sub { color: var(--text-muted); font-size: 1.05rem; }

/* ==================== PLACES SECTIONS ==================== */
.places-section {
    padding: 6rem 2rem;
    background: var(--cream);
}

.places-dark {
    background: var(--dark-2);
}

.places-dark .section-title { color: var(--white); }
.places-dark .section-sub { color: var(--text-light); }

.places-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
}

.place-card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: var(--transition);
    position: relative;
}

.places-dark .place-card { background: var(--dark-3); }

.place-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-hover);
}

.card-image {
    position: relative;
    height: 240px;
    overflow: hidden;
}

.card-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.place-card:hover .card-image img { transform: scale(1.08); }

.card-badge {
    position: absolute;
    top: 1rem; left: 1rem;
    background: var(--gold);
    color: var(--dark);
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    z-index: 2;
}

.card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
}

.place-card:hover .card-overlay { opacity: 1; }

.card-btn {
    background: var(--gold);
    color: var(--dark);
    padding: 0.75rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.9rem;
    transform: translateY(15px);
    transition: var(--transition);
}

.place-card:hover .card-btn { transform: translateY(0); }

.card-body { padding: 1.5rem; }

.card-rating { color: var(--gold); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.5rem; }
.stars { font-size: 1rem; }

.card-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--dark);
}

.places-dark .card-title { color: var(--white); }

.card-location { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.75rem; }

.card-desc { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.6; }

.places-dark .card-desc { color: var(--text-light); }

.card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(0,0,0,0.07);
    padding-top: 1rem;
}

.places-dark .card-footer { border-color: rgba(255,255,255,0.07); }

.card-price { display: flex; align-items: baseline; gap: 0.3rem; flex-wrap: wrap; }
.price-from { font-size: 0.75rem; color: var(--text-muted); }
.price-val { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: var(--gold); }
.price-dur { font-size: 0.75rem; color: var(--text-muted); }

.btn-card {
    background: var(--dark);
    color: var(--white);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: var(--transition);
}

.btn-card:hover { background: var(--gold); color: var(--dark); }

.places-dark .btn-card { background: rgba(255,255,255,0.1); }
.places-dark .btn-card:hover { background: var(--gold); color: var(--dark); }

.section-cta { text-align: center; margin-top: 3rem; }

.btn-outline {
    display: inline-block;
    border: 2px solid var(--dark);
    color: var(--dark);
    padding: 0.9rem 2.5rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition);
}

.btn-outline:hover { background: var(--dark); color: var(--white); }

.btn-outline-light {
    border-color: var(--gold);
    color: var(--gold);
}

.btn-outline-light:hover { background: var(--gold); color: var(--dark); }

/* ==================== WHY US ==================== */
.why-section {
    padding: 6rem 2rem;
    background: var(--cream-2);
}

.why-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
}

.why-card {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: var(--white);
    border-radius: var(--radius);
    transition: var(--transition);
    border-bottom: 3px solid transparent;
}

.why-card:hover { border-bottom-color: var(--gold); transform: translateY(-6px); box-shadow: var(--shadow); }

.why-icon { font-size: 2.5rem; margin-bottom: 1rem; }
.why-card h3 { font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 0.75rem; }
.why-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.7; }

/* ==================== TESTIMONIALS ==================== */
.testimonials-section {
    padding: 6rem 2rem;
    background: var(--dark);
    overflow: hidden;
}

.testimonials-section .section-title { color: var(--white); }
.testimonials-section .section-sub { color: var(--text-light); }

.testimonials-track {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
}

.testimonial-card {
    background: var(--dark-3);
    border: 1px solid rgba(201,168,76,0.15);
    border-radius: var(--radius);
    padding: 2.5rem;
    transition: var(--transition);
}

.testimonial-card:hover { border-color: rgba(201,168,76,0.4); transform: translateY(-5px); }

.testi-stars { color: var(--gold); font-size: 1.1rem; margin-bottom: 1.25rem; }
.testimonial-card p { color: var(--text-light); line-height: 1.8; font-style: italic; margin-bottom: 1.5rem; }

.testi-author { display: flex; align-items: center; gap: 1rem; }
.testi-author img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gold); }
.testi-author strong { display: block; color: var(--white); font-size: 0.95rem; }
.testi-author span { color: var(--text-muted); font-size: 0.8rem; }

/* ==================== NEWSLETTER ==================== */
.newsletter-section {
    padding: 5rem 2rem;
    background: linear-gradient(135deg, var(--gold) 0%, #A67C3A 100%);
    text-align: center;
}

.newsletter-content h2 { font-family: var(--font-display); font-size: 2.5rem; color: var(--dark); margin-bottom: 0.75rem; }
.newsletter-content h2 em { font-style: italic; }
.newsletter-content p { color: rgba(13,13,13,0.7); margin-bottom: 2rem; font-size: 1.05rem; }

.newsletter-form { display: flex; gap: 0; max-width: 500px; margin: 0 auto; border-radius: 50px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.2); }
.newsletter-form input { flex: 1; padding: 1rem 1.5rem; border: none; outline: none; font-family: var(--font-body); font-size: 0.95rem; }
.newsletter-form button { background: var(--dark); color: var(--white); border: none; padding: 1rem 2rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: var(--transition); }
.newsletter-form button:hover { background: var(--dark-4); }

/* ==================== PAGE HERO ==================== */
.page-hero {
    height: 50vh;
    min-height: 400px;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 4rem 8%;
}

.short-hero { height: 40vh; min-height: 320px; }

.page-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.5);
}

.page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
    z-index: 1;
}

.page-hero-content { position: relative; z-index: 2; color: var(--white); }
.page-hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    margin: 0.5rem 0;
}
.page-hero-content h1 em { color: var(--gold); font-style: italic; }
.page-hero-content p { color: rgba(255,255,255,0.8); max-width: 600px; font-size: 1.05rem; }

/* ==================== ALL PLACES PAGE ==================== */
.all-places-section { padding: 4rem 2rem 6rem; }

.filter-bar {
    max-width: 1400px;
    margin: 0 auto 3rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.filter-btn {
    background: var(--white);
    border: 2px solid var(--cream-2);
    color: var(--dark);
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.filter-btn:hover, .filter-btn.active { background: var(--gold); border-color: var(--gold); color: var(--dark); }

.places-grid-full {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
}

/* ==================== ABOUT PAGE ==================== */
.about-story { padding: 6rem 2rem; background: var(--cream); }
.about-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
.about-text .section-title { text-align: left; }
.about-text p { color: #555; line-height: 1.8; margin-bottom: 1.25rem; }
.about-stats { display: flex; gap: 2.5rem; margin-top: 2rem; padding-top: 2rem; border-top: 2px solid var(--cream-2); }
.about-stats div { text-align: center; }
.about-stats strong { font-family: var(--font-display); font-size: 2rem; color: var(--gold); display: block; }
.about-stats span { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
.about-image-collage { position: relative; height: 450px; }
.collage-main { width: 75%; height: 350px; object-fit: cover; border-radius: 20px; position: absolute; top: 0; right: 0; box-shadow: var(--shadow); }
.collage-sm1 { width: 45%; height: 200px; object-fit: cover; border-radius: 16px; position: absolute; bottom: 0; left: 0; box-shadow: var(--shadow); }
.collage-sm2 { width: 35%; height: 150px; object-fit: cover; border-radius: 12px; position: absolute; bottom: 60px; left: 46%; box-shadow: var(--shadow); }

.values-section { padding: 5rem 2rem; background: var(--dark); }
.values-section .section-title { color: var(--white); }
.values-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(4,1fr); gap: 2rem; }
.value-card { border-top: 3px solid var(--gold); padding: 2rem 1.5rem; }
.value-num { font-family: var(--font-display); font-size: 3rem; color: rgba(201,168,76,0.2); font-weight: 900; margin-bottom: 0.5rem; }
.value-card h3 { font-family: var(--font-display); color: var(--white); margin-bottom: 0.75rem; font-size: 1.2rem; }
.value-card p { color: var(--text-light); font-size: 0.9rem; line-height: 1.7; }

.team-section { padding: 6rem 2rem; background: var(--cream); }
.team-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(4,1fr); gap: 2rem; }
.team-card { text-align: center; background: var(--white); border-radius: var(--radius); overflow: hidden; box-shadow: 0 5px 30px rgba(0,0,0,0.07); transition: var(--transition); }
.team-card:hover { transform: translateY(-8px); box-shadow: var(--shadow); }
.team-img-wrap { height: 280px; overflow: hidden; }
.team-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.team-card:hover .team-img-wrap img { transform: scale(1.05); }
.team-info { padding: 1.5rem; }
.team-info h3 { font-family: var(--font-display); font-size: 1.2rem; margin-bottom: 0.25rem; }
.team-role { display: block; color: var(--gold); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem; }
.team-info p { color: var(--text-muted); font-size: 0.85rem; line-height: 1.6; }

.cta-section { padding: 6rem 2rem; background: var(--dark-2); text-align: center; }
.cta-content h2 { font-family: var(--font-display); font-size: 2.5rem; color: var(--white); margin-bottom: 0.75rem; }
.cta-content h2 em { color: var(--gold); font-style: italic; }
.cta-content p { color: var(--text-light); margin-bottom: 2rem; font-size: 1.05rem; }

/* ==================== BOOKING ==================== */
.booking-section { padding: 4rem 2rem 6rem; background: var(--cream); }
.booking-grid { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 1fr 380px; gap: 3rem; align-items: start; }
.booking-form-wrap { background: var(--white); border-radius: 20px; padding: 3rem; box-shadow: var(--shadow); }
.booking-form-wrap h2 { font-family: var(--font-display); font-size: 2rem; margin-bottom: 2rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.form-group { margin-bottom: 1.5rem; }
.form-group label { display: block; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.5rem; }
.form-group input, .form-group select, .form-group textarea {
    width: 100%;
    padding: 0.85rem 1.1rem;
    border: 2px solid var(--cream-2);
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    background: var(--cream);
    color: var(--dark);
    outline: none;
    transition: var(--transition);
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--gold); background: var(--white); }
.form-group textarea { resize: vertical; }

.btn-submit {
    width: 100%;
    background: var(--gold);
    color: var(--dark);
    border: none;
    padding: 1.1rem 2rem;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    transition: var(--transition);
    letter-spacing: 0.05em;
}
.btn-submit:hover { background: var(--gold-light); transform: translateY(-2px); box-shadow: 0 10px 30px rgba(201,168,76,0.4); }

.booking-sidebar { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: calc(var(--nav-h) + 2rem); }
.selected-trip-card { background: var(--white); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); }
.selected-trip-card img { width: 100%; height: 200px; object-fit: cover; }
.selected-info { padding: 1.5rem; }
.selected-info h3 { font-family: var(--font-display); font-size: 1.3rem; margin: 0.5rem 0 0.25rem; }
.selected-info p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.5rem; }
.selected-desc { line-height: 1.6 !important; }
.selected-price { display: flex; align-items: baseline; gap: 0.4rem; padding-top: 1rem; border-top: 1px solid var(--cream-2); }
.selected-price span { font-size: 0.8rem; color: var(--text-muted); }
.selected-price strong { font-family: var(--font-display); font-size: 1.5rem; color: var(--gold); }

.booking-info-card { background: var(--dark); color: var(--white); border-radius: 16px; padding: 1.75rem; }
.booking-info-card h4 { font-family: var(--font-display); margin-bottom: 1rem; font-size: 1.1rem; }
.booking-info-card ul { display: flex; flex-direction: column; gap: 0.6rem; }
.booking-info-card li { font-size: 0.85rem; color: var(--text-light); }

.booking-contact { background: var(--white); border-radius: 16px; padding: 1.75rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
.booking-contact h4 { font-family: var(--font-display); margin-bottom: 0.5rem; }
.booking-contact p { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem; }
.booking-contact a { display: block; color: var(--dark); font-weight: 600; margin-bottom: 0.5rem; transition: var(--transition); font-size: 0.9rem; }
.booking-contact a:hover { color: var(--gold); }

/* ==================== SUCCESS PAGE ==================== */
.success-section { min-height: calc(100vh - var(--nav-h)); display: flex; align-items: center; justify-content: center; padding: 6rem 2rem; background: var(--cream); }
.success-card { max-width: 680px; width: 100%; background: var(--white); border-radius: 24px; padding: 4rem; text-align: center; box-shadow: var(--shadow); }
.success-icon { font-size: 4rem; margin-bottom: 1.5rem; animation: float 3s ease-in-out infinite; }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
.success-card h1 { font-family: var(--font-display); font-size: 2.2rem; margin-bottom: 1rem; }
.success-name { font-size: 1.1rem; color: var(--text-muted); margin-bottom: 1rem; }
.success-card > p:last-of-type { color: var(--text-muted); line-height: 1.8; margin-bottom: 2.5rem; }
.success-steps { display: flex; align-items: center; margin-bottom: 2.5rem; }
.step { flex: none; text-align: center; }
.step span { display: block; width: 40px; height: 40px; border-radius: 50%; background: var(--cream-2); color: var(--text-muted); font-weight: 700; line-height: 40px; margin: 0 auto 0.4rem; }
.step.active span { background: var(--gold); color: var(--dark); }
.step p { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; }
.step-line { flex: 1; height: 2px; background: var(--cream-2); margin-bottom: 1.5rem; }
.success-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

/* ==================== FOOTER ==================== */
.footer { background: var(--dark); color: var(--white); padding: 4rem 2rem 0; }
.footer-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; padding-bottom: 3rem; border-bottom: 1px solid rgba(255,255,255,0.07); }
.footer-brand .logo-text { font-family: var(--font-display); font-size: 1.5rem; }
.footer-brand .logo-icon { color: var(--gold); font-size: 1.2rem; }
.footer-brand p { color: var(--text-light); font-size: 0.9rem; line-height: 1.7; margin-top: 1rem; }
.footer-links h4 { font-family: var(--font-display); font-size: 1rem; margin-bottom: 1.25rem; color: var(--gold); }
.footer-links a { display: block; color: var(--text-light); font-size: 0.9rem; margin-bottom: 0.6rem; transition: var(--transition); }
.footer-links a:hover { color: var(--white); transform: translateX(4px); }
.footer-bottom { text-align: center; padding: 1.5rem; color: var(--text-muted); font-size: 0.85rem; }

/* ==================== RESPONSIVE ==================== */
@media (max-width: 1024px) {
    .why-grid, .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .values-grid { grid-template-columns: repeat(2, 1fr); }
    .team-grid { grid-template-columns: repeat(2, 1fr); }
    .booking-grid { grid-template-columns: 1fr; }
    .booking-sidebar { position: static; }
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .footer-content { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 768px) {
    :root { --nav-h: 65px; }
    .nav-links { display: none; flex-direction: column; position: fixed; top: var(--nav-h); left: 0; right: 0; background: var(--dark-2); padding: 1.5rem; gap: 0.5rem; box-shadow: var(--shadow); }
    .nav-links.open { display: flex; }
    .nav-dropdown .dropdown-menu { position: static; transform: none; opacity: 1; pointer-events: all; box-shadow: none; background: rgba(255,255,255,0.05); border: none; margin-top: 0.5rem; }
    .nav-toggle { display: flex; }
    .search-box { grid-template-columns: 1fr; border-radius: 12px; }
    .search-field { border-right: none; border-bottom: 1px solid rgba(201,168,76,0.1); }
    .search-btn { padding: 1.2rem; }
    .slide-title { font-size: 2.5rem; }
    .testimonials-track { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr 1fr; }
    .team-grid { grid-template-columns: 1fr 1fr; }
    .values-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .footer-content { grid-template-columns: 1fr; gap: 2rem; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
    .why-grid, .team-grid { grid-template-columns: 1fr; }
    .slide-content { left: 5%; bottom: 10%; }
    .slide-title { font-size: 2rem; }
    .collage-sm1, .collage-sm2 { display: none; }
    .about-image-collage { height: 280px; }
    .collage-main { width: 100%; height: 280px; }
}
